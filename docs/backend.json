
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "description": "Represents a user's profile in the application.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user, matching the Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "mobile": {
          "type": "string",
          "description": "The user's mobile phone number."
        },
        "email": {
            "type": "string",
            "description": "The user's email address (auto-generated)."
        },
        "state": {
          "type": "string",
          "description": "The state where the user resides."
        },
        "district": {
          "type": "string",
          "description": "The district where the user resides."
        },
        "balance": {
          "type": "number",
          "description": "The user's current wallet balance."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Suspended", "Inactive"],
          "description": "The status of the user's account."
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Enroller", "User"],
          "description": "The role of the user in the application."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user account was created."
        },
        "commissionRate": {
          "type": "number",
          "description": "The commission rate for enrollers."
        }
      },
      "required": ["id", "name", "mobile", "email", "state", "district", "balance", "status", "role", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
        {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profiles. Path-based ownership, where `userId` matches `request.auth.uid`."
        }
      }
    ]
  }
}
