
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth.uid == userId;
      }

      allow get: if isOwner() || isAdmin();
      allow list: if request.auth != null; 
      allow create: if isOwner() && request.resource.data.id == userId;
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }
    
    match /markets/{marketId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /bet_types/{betTypeId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /kalyan_results/{kalyanResultId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /roles_admin/{userId} {
        allow read, write: if false;
    }
  }
}
