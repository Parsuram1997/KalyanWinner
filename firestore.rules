
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins have full access to all data
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read their own transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Transactions are created via server actions
    }
    
    // Publicly readable collections for all authenticated users
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /bet_types/{betTypeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /game_rates/{rateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /kalyan_results/{resultId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /payment_settings/{settingsId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // Admins can manage counters
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
