
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Admin status is determined by the 'role' field in the user's own profile.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      // Admins can get any user profile, users can only get their own.
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin(); 
      // A user can create their own profile document, ensuring the ID matches.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Admins can update any user, users can only update their own.
      allow update: if isOwner(userId) || isAdmin();
      // Admins can delete any user, users can only delete their own.
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /kalyan_results/{kalyanResultId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // This collection is no longer used for admin checks but might be used for other roles.
    // For now, locking it down completely.
     match /roles_admin/{userId} {
        allow read, write: if false;
    }
  }
}
