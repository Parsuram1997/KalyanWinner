
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // In a production environment, this should be based on custom claims.
      // For example: return request.auth.token.admin == true;
      // For now, we check a role in the user's document.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth.uid == userId;
      }

      // Admins can get any user profile, users can only get their own.
      allow get: if isOwner() || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin(); 
      // A user can create their own profile document, ensuring the ID matches.
      allow create: if isOwner() && request.resource.data.id == userId;
      // Admins can update any user, users can only update their own.
      allow update: if isOwner() || isAdmin();
      // Admins can delete any user, users can only delete their own.
      allow delete: if isOwner() || isAdmin();
    }
    
    match /markets/{marketId} {
      // All users (including unauthenticated) can read market timings.
      allow read: if true;
      // Only admins can create, update, or delete markets.
      allow write: if isAdmin();
    }

    match /bet_types/{betTypeId} {
      // All users can read the available bet types.
      allow read: if true;
      // Only admins can create, update, or delete bet types.
      allow write: if isAdmin();
    }

    match /kalyan_results/{kalyanResultId} {
      // Allow anyone to read results. This is public data.
      allow read: if true;
      // Only admins can write (create, update, delete) results.
      allow write: if isAdmin();
    }

    // This collection is no longer used for admin checks but might be used for other roles.
    // For now, locking it down completely.
     match /roles_admin/{userId} {
        allow read, write: if false;
    }
  }
}
