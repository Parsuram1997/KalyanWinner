
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth == null || request.auth.uid != userId;
      allow list: if isAdmin();
    }

    match /transactions/{transactionId} {
      // Admins can do anything. Users can get their own transactions.
      allow get: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      // Users can list transactions only if they are querying by their own userId.
      allow list: if isAdmin() || (request.auth != null && request.query.where[0][0] == 'userId' && request.query.where[0][1] == '==' && request.query.where[0][2] == request.auth.uid);
      
      // All writes are through server-side logic (Cloud Functions or trusted server).
      allow write: if false; 
    }
    
    // Publicly readable collections
    match /markets/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /bet_types/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /game_rates/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /kalyan_results/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /payment_settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
